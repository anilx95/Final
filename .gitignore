# ==============================================================================
# Comprehensive .gitignore for ClassAbly Platform
# ==============================================================================

# --- Secrets & Environment Variables ---
.env
.env.*
*.env
*.env.local
*.env.production
*.env.development
!.env.example
secrets.json
credentials.json
*.pem
*.key
*.cert

# --- Environments & Virtual Envs ---
.venv/
venv/
ENV/
env/
pythonenv*/
.envrc
.conda/

# --- Python Bytecode, Compilations & Testing Caches ---
__pycache__/
*/__pycache__/
*/**/__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
.pytest_cache/
*/.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.hypothesis/

# --- Node & Frontend Build Artifacts ---
node_modules/
*/node_modules/
*/**/node_modules/
dist/
*/dist/
build/
*/build/
.output/
.next/
.nuxt/
.cache/
*/.cache/
.parcel-cache/
.turbo/

# --- Logs ---
*.log
*/logs/
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.system_generated/

# --- Uploads, User Content, Media & Recordings ---
uploads/
*/uploads/
*/**/uploads/
recordings/
*/recordings/
*/**/recordings/
notes_cache/
*/notes_cache/
*/**/notes_cache/

# Audio / Video Formats
*.mp4
*.webm
*.mkv
*.avi
*.mov
*.flv
*.wmv
*.mp3
*.wav
*.m4a
*.ogg
*.aac
*.flac
*.wma

# Large Images & Debug Dumps
debug_*.jpg
debug_*.png
debug_*.jpeg
ocr_processed.jpg
ocr_region.jpg
*.raw
*.psd

# Generated Documents & Artifacts
*.pdf
*.docx
*.pptx
*.xlsx
*.csv

# --- Database & Local Storage Files ---
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
test_*.db
test_classably.db
test_otp_auth.db
test_ai_general_and_clear.db
test_e2e_classably.db

# --- Model Weights, Checkpoints & Large Archives ---
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.pt
*.pth
*.onnx
*.bin
*.h5
*.tflite
*.safetensors
*.ckpt
yolo11n.pt

# --- Temporary & Scratch Files ---
scratch/
*/scratch/
test_paddle.py
test_smtp.py
create_local_admin.py
verify_admin.py
scratch_20_users.json
*.tmp
*.temp
*~

