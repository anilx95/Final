# ==============================================================================
# ClassAbly Platform Configuration Template
# Copy this file to .env and configure with your environment settings
# ==============================================================================

# Application
APP_NAME=ClassAbly
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./classably.db

# Authentication
SECRET_KEY=change-this-to-a-secure-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / Vision / Gemini API (Optional)
GEMINI_API_KEY=

# Email Provider & OTP Configuration
# Set EMAIL_PROVIDER=smtp for Local Gmail SMTP
# Set EMAIL_PROVIDER=resend for Railway Production HTTPS API
EMAIL_PROVIDER=smtp

# Resend HTTPS API Settings (for Railway production: EMAIL_PROVIDER=resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=ClassAbly

# Gmail / SMTP Settings (for Local development: EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ClassAbly

# OTP Behavior
OTP_EXPIRE_MINUTES=5
OTP_COOLDOWN_SECONDS=60
MOCK_EMAIL_IN_DEV=False

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:3000
